{
  "name": "round-sun-9035",
  "main": "worker.js",
  "compatibility_date": "2024-06-02",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "ai": {
    "bindings": [
      {
        "name": "AI",
        "model_namespace": "@cf/openai",
        "model_name": "whisper-large-v3-turbo",
        "type": "ai_model"
      }
    ]
  }
}